# ============================================
# MARMU SaaS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha
# NUNCA commite o arquivo .env.local
# ============================================

# --- Supabase (obrigatório para rodar local) ---
# Encontre em: app.supabase.com → Settings → API
# Ou use o valor gerado por: supabase start
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Conta master da plataforma (dono do SaaS) ---
# Este e-mail recebe role=master automaticamente ao logar
# Fase 4: substituído por registro na tabela profiles do Supabase
VITE_MASTER_EMAIL=seuemail@exemplo.com

# --- Sentry (monitoramento de erros) ---
VITE_SENTRY_DSN=

# ============================================
# SOMENTE em Supabase Edge Functions secrets
# Nunca no frontend, nunca no .env.local
# ============================================
# GEMINI_API_KEY=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENVIRONMENT=sandbox
# ============================================

# Legado AI Studio (não usar no SaaS)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"

# === AIOX Variables (added 2026-05-25) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.2.9
